# Apache settings for <folder>/_astro/ (copied there as .htaccess by scripts/package.mjs).
# Every file in this folder has a content hash in its name and never changes, so browsers may keep
# it for a year; a new build writes new names.
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
