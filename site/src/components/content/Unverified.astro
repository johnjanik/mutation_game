---
// <Unverified item="E4" fallback="..."> ... </Unverified> (SPEC.md 7.3; 8.4; 9.3) wraps a sentence
// that rests on an open item of Appendix E, named by its number there.
// Preview build (the default): the sentence with a visible mark linking to `open-items#<item>`,
// whatever the item's status. Release build (RELEASE=1): a closed item's sentence unmarked; for an
// open item the fallback in its place, or nothing without one. A fallback is a weaker sentence that
// stays true however the item turns out, for example "computed for every board of rank at most 8"
// in place of a statement about what a book says.
// This component never fails the build: an item that is not in unverified.json is treated as open
// and named in the mark and in the release report. Inline elements only (it sits in a paragraph).
import { decide, isReleaseBuild, itemById, registerUsage } from '@lib/unverifiedRegistry';

interface Props {
  item: string;
  fallback?: string;
}

const { item: rawItem, fallback } = Astro.props;
const item = typeof rawItem === 'string' && rawItem !== '' ? rawItem : '(no item)';
const hasFallback = typeof fallback === 'string' && fallback !== '';
const release = isReleaseBuild();
const shown = decide(item, release, hasFallback);
registerUsage(item, Astro.url.pathname, hasFallback);
const known = itemById(item) !== undefined;
const base = import.meta.env.BASE_URL;
const href = `${base.endsWith('/') ? base : `${base}/`}open-items#${item}`;
const markText = known ? `[unverified ${item}]` : `[unverified ${item}, not in unverified.json]`;
const title = `Rests on item ${item} of Appendix E; see its status on the open-items page`;
---
{shown === 'marked' && (
  <span class="unverified" data-unverified={item}><slot /> <a class="unverified-mark" href={href} title={title}>{markText}</a></span>
)}
{shown === 'plain' && <slot />}
{shown === 'fallback' && <span class="unverified-fallback" data-unverified={item}>{fallback}</span>}

<style>
  .unverified {
    text-decoration: underline dotted;
    text-decoration-color: var(--text);
    text-underline-offset: 0.2em;
  }
  .unverified-mark {
    font-size: 0.85em;
    white-space: nowrap;
  }
  .unverified-mark:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }
</style>
