---
// The index of the Atlas, /atlas/ (SPEC.md 4 T14; 4.0 Board pickers: "the 32 named types, grouped by
// letter"; 3 M10). Owner P6-A4. Each board with its typeset name from names.json (7.3) as a link to its page,
// and its drawing (6.1, 6.2) with a text alternative (A-10). Static: no island and no script (7.6: a page with
// no tool). Every href is built from import.meta.env.BASE_URL (7.2 item 10).
// Hooks: data-atlas-index on the list, data-group (the letter) on each group, data-board-link on each link.
import Page from '../../layouts/Page.astro';
import Diagram from '@components/atlas/Diagram.svelte';
import { ATLAS_GROUPS, ATLAS_BOARDS } from '@components/atlas/boards';
import { boardDiagram } from '@components/atlas/diagram';
import { typeName } from '@components/atlas/names';

const base = import.meta.env.BASE_URL;
const href = (name: string): string => `${base}atlas/${name}/`;
---

<Page title="Atlas" description="A data sheet for each of the 32 boards of finite type, computed by the engine.">
  <p>
    The Atlas has a data sheet for each of the {ATLAS_BOARDS.length} boards of finite type of rank at most 8: the Cartan matrix in two
    conventions, the roads, weights and roots, the highest roots, exponents and Weyl group, the affine board and the real forms,
    computed by the site's engine when the site was built. Each sheet links every item to a tool that shows it with that board loaded.
  </p>
  <div class="atlas-index" data-atlas-index>
    {ATLAS_GROUPS.map((g) => (
      <section aria-labelledby={`group-${g.letter}`} data-group={g.letter}>
        <h2 id={`group-${g.letter}`}>Type {g.letter}</h2>
        <ul class="cards">
          {g.names.map((name) => (
            <li class="card">
              <a href={href(name)} data-board-link={name} aria-label={name}><Fragment set:html={typeName(name)} /></a>
              <Diagram diagram={boardDiagram(name, 30)} label={`Diagram of ${name}`} />
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Page>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 8px 12px;
    border: 1px solid var(--sign-zero-outline);
    border-radius: 4px;
    min-width: 0;
  }
  .card a {
    display: inline-block;
    min-height: 24px;
    font-size: 1.1rem;
  }
  /* The whole card follows the link; the drawing stays outside the link, an image with its own name. */
  .card a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card:has(a:focus-visible) {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
  }
  .card a:focus-visible {
    outline: none;
  }
</style>
