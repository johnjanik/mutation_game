---
// One route per registered tool, /embed/<id> (SPEC.md 7.4 "Embedding", 7.3; CONTRACTS.md 5.2). Owner
// P6-A5. The tool alone, for an <iframe>: its default state with its caption, hydrated when the browser
// is idle (7.6), with an empty instance id so that the URL keys are bare and the same query as on
// /tools/<id> loads the same state (6.6); the tool reads the URL itself through decodeState. No site
// navigation, header, theme switch or footer; the tokens and themes of the site follow the reader's
// prefers-color-scheme (an embedding page cannot reach the stored theme). The page is not indexed and
// names /tools/<id> as canonical; one link under the tool opens the same state on the site. Every path
// comes from import.meta.env.BASE_URL (7.2 item 10).
//
// Hydration (P1-A2 trap 1): Astro hydrates only components imported statically in the file that sets
// the client directive. The table of hydrated tools is the shared module src/tools/ToolIsland.astro
// (request R1 of P6-A5, decisions/P6-A5.md), which pages/tools/[tool].astro renders too; it is
// imported statically here, so every registered tool gets its /embed/<id> route, and a build without
// that module fails instead of dropping the routes.
import '../../styles/base.css';
import { katexStylesheetHref } from '@lib/katex';
import ToolIsland from '../../tools/ToolIsland.astro';
import { toolRoutes, type ToolRoute } from '../../tools/index';

export function getStaticPaths(): ToolRoute[] {
  return toolRoutes();
}

const { entry, caption } = Astro.props as ToolRoute['props'];
const base = import.meta.env.BASE_URL;
const toolPath = `${base}tools/${entry.id}/`;
const canonical = new URL(toolPath, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{entry.title}</title>
    <meta name="description" content={caption} />
    <link rel="canonical" href={canonical} />
    <link rel="stylesheet" href={katexStylesheetHref(base)} />
  </head>
  <body data-embed={entry.id}>
    <main class="embed">
      <ToolIsland entry={entry} caption={caption} />
      <p class="open-on-site">
        <a href={toolPath} data-href={toolPath} data-open-on-site target="_blank" rel="noopener">Open on the site</a>
      </p>
    </main>
    <script is:inline>
      // "Open on the site" carries the state this page shows: the query the address bar holds now.
      (function () {
        var a = document.querySelector('[data-open-on-site]');
        if (!a) return;
        var set = function () { a.href = a.getAttribute('data-href') + location.search; };
        set();
        ['focus', 'pointerenter', 'pointerdown', 'click'].forEach(function (t) { a.addEventListener(t, set); });
      })();
    </script>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    line-height: 1.5;
  }
  .embed {
    max-width: 42rem;
    margin-inline: auto;
    padding-inline: 16px;
  }
  .open-on-site {
    margin: 0 0 16px;
  }
  .open-on-site a {
    display: inline-block;
    min-height: 24px;
    padding: 10px 0;
    color: var(--text);
  }
  .open-on-site a:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
  }
</style>
