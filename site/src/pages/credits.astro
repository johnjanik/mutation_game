---
// The phase-0 credits page (SPEC.md 7.3, 7.9, 9.3; D4, D5). No island, no script. The list of
// dependencies is generated at build time from the three package.json files of the repository,
// with each licence read from the installed package, so the page cannot drift from the lockfile.
// P1-A4 converts this page to site/src/content/pages/credits.mdx and turns [W20] and [W-MS]
// into <Cite>.
import { existsSync, readFileSync } from 'node:fs';
import { dirname, join, resolve } from 'node:path';
import Base from '../layouts/Base.astro';

interface PackageJson {
  name?: string;
  version?: string;
  license?: unknown;
  licenses?: unknown;
  author?: unknown;
  homepage?: unknown;
  repository?: unknown;
  workspaces?: unknown;
  dependencies?: Record<string, string>;
  devDependencies?: Record<string, string>;
}

const readJson = (file: string): PackageJson => JSON.parse(readFileSync(file, 'utf8')) as PackageJson;

/** The repository root: the nearest directory above the working directory whose package.json has workspaces. */
function findRoot(from: string): string {
  let dir = resolve(from);
  for (;;) {
    const file = join(dir, 'package.json');
    if (existsSync(file) && readJson(file).workspaces) return dir;
    const up = dirname(dir);
    if (up === dir) throw new Error(`credits: no workspace root above ${from}`);
    dir = up;
  }
}

const root = findRoot(process.cwd());
const manifests = [
  { where: 'root', dir: root },
  { where: 'engine', dir: join(root, 'packages', 'engine') },
  { where: 'site', dir: join(root, 'site') },
];

/** The installed package.json of a dependency, looked up as Node resolves it from that workspace. */
function installed(name: string, fromDir: string): { pkg: PackageJson; dir: string } | null {
  let dir = fromDir;
  for (;;) {
    const file = join(dir, 'node_modules', name, 'package.json');
    if (existsSync(file)) return { pkg: readJson(file), dir: dirname(file) };
    if (dir === root) return null;
    const up = dirname(dir);
    if (up === dir) return null;
    dir = up;
  }
}

function licenceOf(pkg: PackageJson | null): string | null {
  if (!pkg) return null;
  if (typeof pkg.license === 'string' && pkg.license.trim() !== '') return pkg.license.trim();
  if (pkg.license && typeof pkg.license === 'object' && 'type' in pkg.license) return String((pkg.license as { type: unknown }).type);
  if (Array.isArray(pkg.licenses)) return pkg.licenses.map((l) => (typeof l === 'string' ? l : String((l as { type?: unknown }).type))).join(' OR ');
  return null;
}

/** The author field, or else the copyright line of the package's licence file, as found. */
function authorOf(pkg: PackageJson | null, dir: string | null): string | null {
  const a = pkg?.author;
  if (typeof a === 'string') return a.replace(/\s*<[^>]*>/, '').replace(/\s*\([^)]*\)/, '').trim();
  if (a && typeof a === 'object' && 'name' in a) return String((a as { name: unknown }).name);
  if (dir === null) return null;
  for (const f of ['LICENSE', 'LICENSE.md', 'LICENSE.txt', 'license', 'license.md']) {
    const file = join(dir, f);
    if (!existsSync(file)) continue;
    const line = readFileSync(file, 'utf8').split('\n').find((l) => /^\s*Copyright\b/.test(l) && !/\[yyyy\]|\{yyyy\}/.test(l));
    if (line) return line.trim();
  }
  return null;
}

function sourceOf(pkg: PackageJson | null): string | null {
  const r = pkg?.repository;
  let url: string | null = null;
  if (typeof r === 'string') url = r;
  else if (r && typeof r === 'object' && 'url' in r) url = String((r as { url: unknown }).url);
  if (url === null) return typeof pkg?.homepage === 'string' ? pkg.homepage : null;
  if (/^[\w.-]+\/[\w.-]+$/.test(url)) url = `https://github.com/${url}`;
  return url.replace(/^git\+/, '').replace(/^git:\/\//, 'https://').replace(/\.git$/, '');
}

/** What reaches the reader's browser (SPEC.md 7.6, 7.9): everything else is used only by the build. */
const SHIPPED: Record<string, string> = {
  astro: 'the island loader inlined in each page with a tool',
  '@astrojs/svelte': 'the client renderer of the islands',
  svelte: 'the runtime of the islands',
  katex: 'the stylesheet and fonts (no script)',
};

interface Row {
  name: string;
  pinned: string;
  version: string;
  licence: string | null;
  author: string | null;
  source: string | null;
  usedIn: string[];
  shipped: string | null;
}

const rows = new Map<string, Row>();
for (const m of manifests) {
  const pkg = readJson(join(m.dir, 'package.json'));
  for (const [field, kind] of [
    ['dependencies', 'dependency'],
    ['devDependencies', 'development dependency'],
  ] as const) {
    for (const [name, pinned] of Object.entries(pkg[field] ?? {})) {
      const found = installed(name, m.dir);
      const inst = found?.pkg ?? null;
      const row = rows.get(name) ?? {
        name,
        pinned,
        version: inst?.version ?? 'not installed',
        licence: licenceOf(inst),
        author: authorOf(inst, found?.dir ?? null),
        source: sourceOf(inst),
        usedIn: [],
        shipped: SHIPPED[name] ?? null,
      };
      row.usedIn.push(`${m.where} (${kind})`);
      rows.set(name, row);
    }
  }
}
const dependencies = [...rows.values()].sort((a, b) => a.name.localeCompare(b.name, 'en'));
const unreadable = dependencies.filter((r) => r.licence === null).map((r) => r.name);

// KaTeX's fonts ship inside the katex package; read the notices the package carries.
const katexDir = join(root, 'site', 'node_modules', 'katex');
const katexHome = existsSync(join(katexDir, 'package.json')) ? katexDir : join(root, 'node_modules', 'katex');
const katexPkg = readJson(join(katexHome, 'package.json'));
const katexLicenceText = readFileSync(join(katexHome, 'LICENSE'), 'utf8');
const katexLicenceTitle = katexLicenceText.split('\n')[0]!.trim();
const katexCopyright = katexLicenceText.split('\n').find((l) => l.startsWith('Copyright'))?.trim() ?? 'no copyright line found';
const fontNotice = ['OFL.txt', 'fonts/LICENSE', 'dist/fonts/LICENSE', 'dist/fonts/OFL.txt'].find((f) => existsSync(join(katexHome, f))) ?? null;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<Base title="Credits: Two Games on a Dynkin Diagram">
  <h1>Credits</h1>

  <section aria-labelledby="story">
    <h2 id="story">The games and the story</h2>
    <p>
      The mutation game is N. J. Wildberger's. So are the words city and population for its board and
      positions, and the story told with them: Martians and anti-Martians living in the cities of Mars, and
      Venus for the dual game. This site retells that story with his credit, from [W20] section 2 and
      [W-MS] pp. 1 and 30.
    </p>
    <p>
      The numbers game is Mozes', with Proctor's earlier use of the same process and Eriksson's development
      of it acknowledged.
    </p>
  </section>

  <section aria-labelledby="licences">
    <h2 id="licences">Licences of this site</h2>
    <p>
      The text and figures of this site are licensed under the Creative Commons Attribution-ShareAlike 4.0
      International licence (CC BY-SA 4.0; SPDX: CC-BY-SA-4.0), in the file LICENSE-content of the repository. The code is
      licensed under the GNU Affero General Public License version 3 (SPDX: AGPL-3.0-only), in the file
      LICENSE. Code samples shown in the text fall under the code licence.
    </p>
  </section>

  <section aria-labelledby="fonts">
    <h2 id="fonts">Fonts</h2>
    <p>
      The only font files the site ships are KaTeX's own, copied from the installed katex package, version
      {katexPkg.version}, by KaTeX's authors (source: {sourceOf(katexPkg)}). The package carries one licence
      notice, {katexLicenceTitle} ("{katexCopyright}"), in its LICENSE file{fontNotice === null
        ? ', and no separate notice for the fonts'
        : `, and a separate notice for the fonts in ${fontNotice}`}. Prose and numerals use the system fonts of
      the reader's device.
    </p>
  </section>

  <section aria-labelledby="deps">
    <h2 id="deps">Software</h2>
    <p>
      Every package named in the three package.json files of the repository (the root, the engine and the
      site), with the version installed and the licence stated by the installed package. Four of them reach
      the reader's browser, as marked; the rest are used only to build and test the site.
    </p>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Software used by this site">
      <table data-out="creditsTable">
        <thead>
          <tr>
            <th scope="col">Package</th>
            <th scope="col">Version</th>
            <th scope="col">Licence</th>
            <th scope="col">Author and source</th>
            <th scope="col">Used</th>
          </tr>
        </thead>
        <tbody>
          {
            dependencies.map((d) => (
              <tr data-package={d.name}>
                <th scope="row">{d.name}</th>
                <td>{d.version}</td>
                <td data-licence>{d.licence ?? 'licence not stated in the package'}</td>
                <td>
                  {d.author ?? 'author not stated in the package'}
                  {d.source && (<><br /><span class="source">{d.source}</span></>)}
                </td>
                <td>
                  {d.shipped ? `shipped to the reader: ${d.shipped}` : 'build and tests only'}
                  <br />
                  <span class="where">{d.usedIn.join('; ')}</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    {unreadable.length > 0 && <p>No licence could be read from the installation for: {unreadable.join(', ')}.</p>}
  </section>

  <p><a href={base}>Back to the board</a> · <a href={`${base}about/`}>About this site</a></p>
</Base>

<style>
  .table-wrap {
    overflow-x: auto;
  }
  table {
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 6px 8px;
    border-bottom: 1px solid var(--sign-zero-outline);
  }
  .source,
  .where {
    overflow-wrap: anywhere;
  }
  .table-wrap:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
  }
</style>
