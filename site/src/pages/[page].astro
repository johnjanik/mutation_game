---
// One route per entry of the `pages` collection (P1-A4; SPEC.md 7.3), at /<slug>/ under the base,
// rendered inside Page.astro. Every entry is built, released or not: a page with released: false
// keeps its route (so its tests can run); only links to it are dropped (lib/pages/released.ts).
// A slug that collides with a static route fails the build here.
import { getCollection, render } from 'astro:content';
import Page from '../layouts/Page.astro';
import { slugCollisions } from '@lib/pages/released';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  const modules = await getCollection('modules');
  const problems = slugCollisions(
    pages.map((p: { id: string }) => p.id),
    modules.map((m: { id: string }) => m.id),
  );
  if (problems.length > 0) throw new Error(`route collision: ${problems.join('; ')}`);
  return pages.map((entry: { id: string }) => ({ params: { page: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Page {...entry.data}>
  <Content />
</Page>
