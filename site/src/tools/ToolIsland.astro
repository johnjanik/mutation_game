---
// The registered tools on a route of their own, /tools/<id> and /embed/<id> (SPEC.md 7.3, 7.4; CONTRACTS.md
// 5.2): the tool alone in its `default` state with its caption, hydrated when the browser is idle (7.6),
// with an empty instance id, so that the tool's URL keys are bare (6.6).
//
// Trap 1 (decisions/P1-A2.md): Astro hydrates only components it sees imported statically; a
// component taken from the registry at run time fails with NoMatchingImport under a client directive
// (tried in a scratch build on Astro 7.3.8). So each tool has one static import and one line below,
// which MERGE adds when the tool lands (two lines per tool). A registered tool without its line is
// still rendered at build time from its registry entry, without hydration, and the build says so.
// The table moved here from pages/tools/[tool].astro so that pages/embed/[tool].astro renders the same
// one (request R1 of P6-A5).
import type { ToolRegistryEntry } from './types';
// Static imports of the tools, in tool order. MERGE adds, for example:
//   import T01GameBoard from '@components/tools/T01GameBoard.svelte';
import T01GameBoard from '@components/tools/T01GameBoard.svelte';
import T02OrbitGarden from '@components/tools/T02OrbitGarden.svelte';
import T03FormFinder from '@components/tools/T03FormFinder.svelte';
import T04ClassificationLab from '@components/tools/T04ClassificationLab.svelte';
import { testBoardPresets } from '@components/board/editor/presets';
import T05NumbersGameLab from '@components/tools/T05NumbersGameLab.svelte';
import T06Kaleidoscope from '@components/tools/T06Kaleidoscope.svelte';
import T07SymbolicGame from '@components/tools/T07SymbolicGame.svelte';
import T08WeylExplorer from '@components/tools/T08WeylExplorer.svelte';
import T09Kostant from '@components/tools/T09Kostant.svelte';
import T10GeometryStudio from '@components/tools/T10GeometryStudio.svelte';
import T11FoldingBench from '@components/tools/T11FoldingBench.svelte';
import T12RepresentationBuilder from '@components/tools/T12RepresentationBuilder.svelte';
import T13SatakeStudio from '@components/tools/T13SatakeStudio.svelte';
import AtlasPicker from '@components/atlas/AtlasPicker.svelte';
import T15AffinePlayground from '@components/tools/t15/T15Route.astro';
import T16Sandbox from '@components/tools/T16Sandbox.svelte';

interface Props {
  entry: ToolRegistryEntry;
  caption: string;
}

const { entry, caption } = Astro.props;

/** The tools that have their static line below (MERGE adds the id with the import). */
const HYDRATED: ReadonlySet<string> = new Set<string>(['affine', 'atlas', 'board', 'fold', 'form', 'garden', 'geometry', 'kostant', 'lab', 'mirror', 'numbers', 'rep', 'sandbox', 'satake', 'symbolic', 'weyl']);

let Unhydrated: ((props: Record<string, unknown>) => unknown) | null = null;
if (!HYDRATED.has(entry.id)) {
  const mod = (await entry.component()) as { default: (props: Record<string, unknown>) => unknown };
  Unhydrated = mod.default;
  console.warn(`[${Astro.url.pathname}] ${entry.id} rendered without hydration: add its static import to src/tools/ToolIsland.astro`);
}
const toolProps = { id: '', caption, preset: 'default' };
---

{/* MERGE adds one line per tool, for example:
    {entry.id === 'board' && <T01GameBoard client:idle {...toolProps} />} */}
{entry.id === 'board' && <T01GameBoard client:idle {...toolProps} />}
{entry.id === 'garden' && <T02OrbitGarden client:idle {...toolProps} />}
{entry.id === 'form' && <T03FormFinder client:idle {...toolProps} />}
{entry.id === 'lab' && <T04ClassificationLab client:idle {...toolProps} boardPresets={testBoardPresets()} />}
{entry.id === 'numbers' && <T05NumbersGameLab client:idle {...toolProps} />}
{entry.id === 'mirror' && <T06Kaleidoscope client:idle {...toolProps} />}
{entry.id === 'symbolic' && <T07SymbolicGame client:idle {...toolProps} />}
{entry.id === 'weyl' && <T08WeylExplorer client:idle {...toolProps} />}
{entry.id === 'kostant' && <T09Kostant client:idle {...toolProps} />}
{entry.id === 'geometry' && <T10GeometryStudio client:idle {...toolProps} />}
{entry.id === 'fold' && <T11FoldingBench client:idle {...toolProps} />}
{entry.id === 'rep' && <T12RepresentationBuilder client:idle {...toolProps} />}
{entry.id === 'satake' && <T13SatakeStudio client:idle {...toolProps} />}
{entry.id === 'atlas' && <AtlasPicker client:idle {...toolProps} />}
{entry.id === 'affine' && <T15AffinePlayground hydrate="idle" {...toolProps} />}
{entry.id === 'sandbox' && <T16Sandbox client:idle {...toolProps} boardPresets={testBoardPresets()} />}
{Unhydrated && <Unhydrated {...toolProps} />}
