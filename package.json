{
  "name": "two-games-on-a-dynkin-diagram",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "packages/*",
    "site"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "prebuild": "node scripts/katex-assets.mjs && node scripts/names.mjs && node scripts/presets.mjs",
    "build": "npm run build -w site",
    "build:release": "RELEASE=1 npm run build",
    "preview": "npm run preview -w site",
    "e2e": "playwright test",
    "e2e:basepath": "BASE_PATH=/sub/path/ OUT_DIR=dist-basepath npm run build && BASE_PATH=/sub/path/ OUT_DIR=dist-basepath playwright test site/tests/e2e/basepath.spec.ts",
    "size": "node scripts/size.mjs",
    "lab": "node scripts/lab.mjs",
    "report": "node scripts/report.mjs",
    "verify": "node scripts/verify.mjs",
    "typecheck": "tsc --noEmit -p packages/engine && npm run check -w site",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
