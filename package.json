    "preview": "npm run preview -w site",
    "e2e": "node -e \"console.error('not yet implemented: P0-A6'); process.exit(2)\"",
    "size": "node -e \"console.error('not yet implemented: P0-A6'); process.exit(2)\"",
    "lab": "node -e \"console.error('not yet implemented: P0-A6'); process.exit(2)\"",
    "report": "node -e \"console.error('not yet implemented: P0-A6'); process.exit(2)\"",
    "verify": "node -e \"console.error('not yet implemented: P0-A6'); process.exit(2)\"",
    "typecheck": "tsc --noEmit -p packages/engine && npm run check -w site",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
